    (string=? f "association") (option-some-of [:option :string] "coparmex")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "MEX")
    (string=? f "kind") (option-some-of [:option :string] "governance-program")
    (string=? f "url") (option-some-of [:option :string] "https://coparmex.org.mx/transparencia/")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-coparmex-org-mx")
    (string=? f "source-article") (option-some-of [:option :string] "Transparencia (Comité de Transparencia, Actas de Comité)")
    (string=? f "source-quote") (option-some-of [:option :string] "Acta de integración de comité de transparencia – 9 de septiembre de 2016")
    (string=? f "established-date") (option-some-of [:option :string] "2016-09-09")
    (string=? f "date-precision") (option-some-of [:option :string] "day")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-24")
    :else (option-none-of [:option :string])))

(defn entry-field-16 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "coparmex.membership-36000")
    (string=? f "title") (option-some-of [:option :string] "COPARMEX states that it has more than 36,000 member employers, responsible for 30% of GDP and 4.8 million formal jobs")
    (string=? f "association") (option-some-of [:option :string] "coparmex")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "MEX")
    (string=? f "kind") (option-some-of [:option :string] "membership-rule")
    (string=? f "url") (option-some-of [:option :string] "https://coparmex.org.mx/ser-socio-coparmex/")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-coparmex-org-mx")
    (string=? f "source-article") (option-some-of [:option :string] "Ser Socio Coparmex")
    (string=? f "source-quote") (option-some-of [:option :string] "Los más de 36,000 empresarios socios en todo el país, responsables del 30% del PIB y de 4.8 millones de empleos formales en el territorio nacional")
    (string=? f "date-unknown-because") (option-some-of [:option :string] "page-states-a-standing-arrangement")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-24")
    :else (option-none-of [:option :string])))

(defn entry-field-17 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "coparmex.international-peer-organisations")
    (string=? f "title") (option-some-of [:option :string] "COPARMEX states that it collaborates with counterpart employers' organisations abroad, naming MEDEF (France), BDI (Germany), UCCAEP (Costa Rica), ANDI (Colombia), CEOE (Spain) and AOTS (Japan)")
    (string=? f "association") (option-some-of [:option :string] "coparmex")
    (string=? f "isic") (option-some-of [:option :string] "9411")
    (string=? f "country") (option-some-of [:option :string] "MEX")
    (string=? f "kind") (option-some-of [:option :string] "international-affiliation")
    (string=? f "url") (option-some-of [:option :string] "https://coparmex.org.mx/representacion-nacional-e-internacional/")
    (string=? f "url-provenance") (option-some-of [:option :string] "official-coparmex-org-mx")
    (string=? f "source-article") (option-some-of [:option :string] "Representación Nacional e Internacional (Representación internacional)")
    (string=? f "source-quote") (option-some-of [:option :string] "desarrollamos una importante vinculación y colaboración con organismos empresariales homólogas a COPARMEX en otros países del mundo, como por ejemplo: MEDEF (Francia), BDI (Alemania), UCCAEP (Costa Rica), ANDI (Colombia), CEOE (España), AOTS (Japón).")
    (string=? f "date-unknown-because") (option-some-of [:option :string] "page-states-a-standing-arrangement")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-24")
    :else (option-none-of [:option :string])))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (entry-field-0 f)
      (= i 1) (entry-field-1 f)
      (= i 2) (entry-field-2 f)
      (= i 3) (entry-field-3 f)
      (= i 4) (entry-field-4 f)
      (= i 5) (entry-field-5 f)
      (= i 6) (entry-field-6 f)
      (= i 7) (entry-field-7 f)
      (= i 8) (entry-field-8 f)
      (= i 9) (entry-field-9 f)
      (= i 10) (entry-field-10 f)
      (= i 11) (entry-field-11 f)
      (= i 12) (entry-field-12 f)
      (= i 13) (entry-field-13 f)
      (= i 14) (entry-field-14 f)
      (= i 15) (entry-field-15 f)
      (= i 16) (entry-field-16 f)
      (= i 17) (entry-field-17 f)
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

